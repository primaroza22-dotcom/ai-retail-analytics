# AI Retail Analytics Platform - environment configuration
# Copy this file to .env and fill in real values locally.
# NEVER commit real credentials to the repository.

APP_NAME=AI Retail Analytics
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database (used from Sprint 6 onward)
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/arap
DATABASE_URL=

# PostgreSQL connection pool (production).
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Camera (used from Sprint 2 onward)
CAMERA_RTSP_URL=

# Camera credentials are provided via environment variables (never plaintext).
# Reference this variable from a camera config via "password_env".
CAMERA_PASSWORD=

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Allowed frontend origins (JSON list) for CORS. Development default:
# http://localhost:3000 and http://127.0.0.1:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Business timezone for daily analytics/forecasting (IANA name).
ANALYTICS_TIMEZONE=UTC

# WebSocket keepalive interval (seconds).
WEBSOCKET_HEARTBEAT_INTERVAL=30

# LLM / AI provider (used for AI-assisted features later)
DEEPSEEK_API_KEY=
