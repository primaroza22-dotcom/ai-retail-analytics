# AI Retail Analytics Platform - environment configuration
# Copy this file to .env and fill in real values locally.
# NEVER commit real credentials to the repository.

APP_NAME=AI Retail Analytics
APP_ENV=development
APP_DEBUG=true

# Database (used from Sprint 6 onward)
# PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/arap
DATABASE_URL=

# Camera (used from Sprint 2 onward)
CAMERA_RTSP_URL=

# Camera credentials are provided via environment variables (never plaintext).
# Reference this variable from a camera config via "password_env".
CAMERA_PASSWORD=

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Allowed frontend origins (JSON list) for CORS. Development default:
# http://localhost:3000 and http://127.0.0.1:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM / AI provider (used for AI-assisted features later)
DEEPSEEK_API_KEY=
